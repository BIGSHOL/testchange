*.pyc
*.pyo
.env
output/
*.hwpx
!templates/*.hwpx
.venv/
venv/

# PyInstaller 빌드 산출물
build/
dist/
build_agent/
dist_agent/
배포용/
배포용.zip
*.pdf

# 런타임 설정(키 포함 가능) — 템플릿은 배포용에만
config.json

# 런타임 산출물 — 토큰 사용/비용 로그
*.log
토큰사용.csv

# 크롭/OCR 영구 기록(머신 로컬·OCR 텍스트·크롭 이미지 — 절대 커밋 금지)
# 루트 앵커(/) — corpus/ 하위의 crop·ocr(JSON 추적 대상)까지 먹지 않게.
/crop/
/ocr/

# 문제 DB — 재생성 가능한 것만 제외하고 산출물(JSON)은 추적한다.
#   pages/  = 페이지 PNG + 원본 PDF 사본(616MB, prep_pages.py 로 재생성)
#   *.db    = SQLite (ingest.py + merge_answers.py 로 JSON 에서 재구축)
#   export/ = Supabase 업로드용 (export_supabase.py 로 재생성)
# ⭐ db/ocr_pilot/*.json 은 **판독 결과 원본**이라 반드시 추적한다(재생성 불가).
# ⭐ db/n_inventory.tsv 도 추적한다 — exam id 는 build_index.py 가 이 목록을
#    정렬해 매기므로, 스캔 시점·PC 가 다르면 id 가 통째로 밀려 기존 판독 JSON 이
#    엉뚱한 시험지에 붙는다. **id 를 재현하는 앵커**라서 산출물로 남긴다.
/db/pages/
/db/export/
/db/*.db
/db/*.db-wal
/db/*.db-shm

# 자가발전 corpus — OCR JSON·crops.json·meta.json 은 추적(재현 비용 큼),
# 페이지/크롭 PNG 는 용량 때문에 제외(원본 PDF·bbox 에서 재생성 가능)
corpus/**/pages/
corpus/**/*.png

# 테스트 하네스 산출물·OCR 캐시(머신 로컬, scripts/testkit.py)
.testkit/
.testkit.zip

# 잡파일
=*

# Claude 런타임/로컬 설정
.claude/scheduled_tasks.lock
.claude/settings.local.json
