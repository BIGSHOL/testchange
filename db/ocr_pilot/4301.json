    {
     "type": "text",
     "value": "전체집합 $U$의 두 부분집합 $A$, $B$에 대하여 $A \\cup B = B$일 때, 다음 중 항상 성립한다고 할 수 __없는__ 것은?"
    }
   ],
   "choices": [
    {
     "number": 1,
     "contents": [
      {
       "type": "equation",
       "value": "A \\subset B"
      }
     ]
    },
    {
     "number": 2,
     "contents": [
      {
       "type": "equation",
       "value": "B^{C} \\subset A^{C}"
      }
     ]
    },
    {
     "number": 3,
     "contents": [
      {
       "type": "equation",
       "value": "A \\cap B = A"
