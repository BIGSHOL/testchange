        {"type": "text", "value": "함수 "},
        {"type": "equation", "value": "f(x)=\\begin{cases}-x & (x\\leq -1)\\\\ x^2-2 & (-1<x\\leq 1)\\\\ -2x+3 & (x>1)\\end{cases}"},
