      "contents": [
        {"type": "text", "value": "[서술형 5] 실수 전체의 집합에서 연속인 함수 "},
        {"type": "equation", "value": "f(x)"},
        {"type": "text", "value": "가 닫힌구간 "},
        {"type": "equation", "value": "[0,\\ 4]"},
        {"type": "text", "value": "에서"},
        {"type": "equation_block", "value": "f(x)=\\begin{cases}-ax+1 & (0\\leq x<2)\\\\ x^2+3ax+b & (2\\leq x\\leq 4)\\end{cases}"},
        {"type": "text", "value": "이고, 모든 실수 "},
        {"type": "equation", "value": "x"},
        {"type": "text", "value": "에 대하여 "},
        {"type": "equation", "value": "f(x+4)=f(x)"},
        {"type": "text", "value": "이다. 실수 "},
        {"type": "equation", "value": "k\\ (k>2)"},
        {"type": "text", "value": "에 대하여 함수 "},
        {"type": "equation", "value": "g(x)"},
        {"type": "text", "value": "가"},
        {"type": "equation_block", "value": "g(x)=\\begin{cases}x+2 & (x\\neq 2)\\\\ k & (x=2)\\end{cases}"},
        {"type": "text", "value": "일 때, 합성함수 "},
        {"type": "equation", "value": "(f\\circ g)(x)"},
        {"type": "text", "value": "가 "},
        {"type": "equation", "value": "x=2"},
        {"type": "text", "value": "에서 연속이 되도록 하는 실수 "},
        {"type": "equation", "value": "k"},
        {"type": "text", "value": "의 최솟값을 구하시오. (단, "},
        {"type": "equation", "value": "a"},
        {"type": "text", "value": ", "},
        {"type": "equation", "value": "b"},
        {"type": "text", "value": "는 상수)"}
      ],
      "choices": []
    },
