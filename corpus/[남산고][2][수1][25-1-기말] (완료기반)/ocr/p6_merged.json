        {"type": "equation", "value": "A_6"},
        {"type": "text", "value": "의 좌표는 각각 "},
        {"type": "equation", "value": "\\left(\\frac{4}{25},\\ 0\\right)"},
        {"type": "text", "value": ", "},
        {"type": "equation", "value": "\\left(1,\\ \\frac{11}{25}\\right)"},
        {"type": "text", "value": "이다. 자연수 "},
        {"type": "equation", "value": "n"},
        {"type": "text", "value": "에 대하여 점 "},
        {"type": "equation", "value": "A_n"},
        {"type": "text", "value": " 중 직선 "},
        {"type": "equation", "value": "y=x"},
